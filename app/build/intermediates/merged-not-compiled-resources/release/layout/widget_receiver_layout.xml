<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_receiver_panel"
    android:padding="10dp">

    <!-- Receiver Top Status & Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTÚDIO DE PLAYBACK • RECEIVER HR-9900"
            android:textColor="#C5A059"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/widget_status_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• HI-FI ON"
            android:textColor="#39FF14"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Album Cover & Track Spec Display Section -->
    <LinearLayout
        android:id="@+id/widget_display_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_display_box"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BIBLIOTECA DE PLAYBACK"
                android:textColor="#39FF14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi-Fi Receiver Engine"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_codec_spec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24-BIT / 192KHZ • FLAC STUDIO"
                android:textColor="#8A9BA8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Control Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp">

        <!-- Previous Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Anterior"
            android:padding="6dp" />

        <!-- Play / Pause Master Button -->
        <ImageButton
            android:id="@+id/widget_btn_play"
            android:layout_width="50dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play/Pause"
            android:padding="6dp" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Próximo"
            android:padding="6dp" />

        <!-- Open Studio Button -->
        <ImageButton
            android:id="@+id/widget_btn_open"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_studio"
            android:contentDescription="Abrir Estúdio"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>
