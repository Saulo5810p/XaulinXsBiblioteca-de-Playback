<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_receiver_panel"
    android:padding="8dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILA DE REPRODUÇÃO • UP NEXT"
            android:textColor="#C5A059"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/widget_status_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• EM REPRODUÇÃO"
            android:textColor="#39FF14"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Top Player Section: Current Track & 3 Control Buttons -->
    <LinearLayout
        android:id="@+id/widget_display_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_display_box"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Capa do Álbum" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma música em execução"
                android:textColor="#39FF14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi-Fi Receiver Engine"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 3 Main Control Buttons -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Anterior"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/widget_btn_play"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play/Pausa"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Próxima"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/widget_btn_open"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_widget_studio"
            android:contentDescription="Abrir Estúdio"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Up Next Queue Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PRÓXIMAS MÚSICAS NA FILA:"
        android:textColor="#8A9BA8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:paddingTop="4dp"
        android:paddingBottom="2dp" />

    <!-- Expandable Queue List Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Queue Item 1 -->
        <LinearLayout
            android:id="@+id/widget_q1_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_queue_item"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:text="1."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C5A059"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingRight="4dp"
                android:paddingEnd="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_q1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Midnight Jazz Lounge"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_q1_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Brushed Aluminum Trio"
                    android:textColor="#8A9BA8"
                    android:textSize="8sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_q1_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLAC 24-BIT"
                android:textColor="#39FF14"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Queue Item 2 -->
        <LinearLayout
            android:id="@+id/widget_q2_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_queue_item"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:text="2."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C5A059"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingRight="4dp"
                android:paddingEnd="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_q2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Neon Receiver Waves"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_q2_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Akai &amp; Technics Ensemble"
                    android:textColor="#8A9BA8"
                    android:textSize="8sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_q2_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AAC 320"
                android:textColor="#FFD700"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Queue Item 3 -->
        <LinearLayout
            android:id="@+id/widget_q3_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_queue_item"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:text="3."
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C5A059"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingRight="4dp"
                android:paddingEnd="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_q3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acoustic Vacuum Tube Suite"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_q3_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sansom High Fidelity"
                    android:textColor="#8A9BA8"
                    android:textSize="8sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_q3_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAV PCM"
                android:textColor="#39FF14"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
